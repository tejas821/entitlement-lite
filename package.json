{
  "name": "entitlement-lite",
  "version": "0.1.0",
  "description": "Tiny, framework-agnostic RBAC/ABAC permission-checking engine for TypeScript — role-based access with an attribute-based escape hatch via rule-lite.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "rbac",
    "abac",
    "authorization",
    "permissions",
    "access-control",
    "entitlements",
    "typescript"
  ],
  "author": "Tejas Kadam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tejas821/entitlement-lite.git"
  },
  "homepage": "https://github.com/tejas821/entitlement-lite#readme",
  "bugs": {
    "url": "https://github.com/tejas821/entitlement-lite/issues"
  },
  "dependencies": {
    "rule-lite": "^0.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=16"
  }
}
